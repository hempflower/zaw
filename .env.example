ZAW_DATABASE_DRIVER=mysql
ZAW_DATABASE_DSN=zaw:zaw@tcp(127.0.0.1:3306)/zaw?parseTime=true&multiStatements=true
# The HTTP listen address used by `task server`.
ZAW_HTTP_ADDR=:8080
# SQLite example:
# ZAW_DATABASE_DRIVER=sqlite
# ZAW_DATABASE_DSN=./.data/zaw.db
ZAW_SECRET_MANAGER_ADDR=http://127.0.0.1:8200
ZAW_SECRET_MANAGER_TOKEN=zaw-local-only
# At least 32 characters. Agent Host bootstrap credentials are signed with it.
ZAW_AGENT_IDENTITY_SIGNING_KEY=change-this-local-agent-identity-key-please
ZAW_STATE_S3_ENDPOINT=http://127.0.0.1:9000
ZAW_STATE_S3_BUCKET=zaw-terraform-state
ZAW_STATE_S3_ACCESS_KEY=zawminio
ZAW_STATE_S3_SECRET_KEY=zawminio-local-only
# Optional Docker endpoint used by Terraform's Docker provider. Rootless Docker
# deployments typically use unix:///run/user/<uid>/docker.sock.
# ZAW_DOCKER_HOST=unix:///run/user/1000/docker.sock
# Incus CLI used by the local Provisioner to inject the fixed Agent Host
# credentials after apply. The credential is never written to Terraform State.
ZAW_INCUS_BINARY=incus
# Optional local `zaw` binary pushed into an Incus VM after Terraform apply.
# ZAW_AGENT_HOST_BINARY=./zaw
# Terraform runs directly on the Provisioner host.
ZAW_TERRAFORM_TIMEOUT=30m
# ZAW_TERRAFORM_PLUGIN_CACHE_DIR=./.data/terraform-plugin-cache
# Failed work directories are deleted by default because template parameters may
# contain private data. Enable this only for controlled local diagnostics.
ZAW_PROVISIONER_RETAIN_FAILED_WORKDIR=false
# Agent Host runtime configuration (model selection and keys stay on Server):
# ZAW_WORKSPACE_ID=01J...
# ZAW_WORKSPACE_DIR=/workspace
# ZAW_AGENT_PROVIDER=copilot
# ZAW_COPILOT_CLI_PATH=copilot
