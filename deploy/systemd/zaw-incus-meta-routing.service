[Unit]
Description=Route Zaw Incus workspaces through the Clash Meta TUN
After=network-online.target docker.service incus.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/zaw-incus-meta-routing
ExecStart=/usr/local/sbin/zaw-incus-meta-routing
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
